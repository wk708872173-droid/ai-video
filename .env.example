# MiniMax-M3 运行时（OpenAI 兼容 HTTP）。复制为仓库根 .env 后填写 Key。
# llm.py 启动时读取本文件，不覆盖已经存在的环境变量。不设 Key 则降级规则引擎。
# ⚠️ 真实 Key 不应入 .env.example（仅占位）。源仓若已泄漏，参考 knowledge/decisions.md D-011 的轮换步骤。
# ⬇️ 默认走 CN 域 api.minimaxi.com（D-013 验证；如海外切 api.minimax.io）
MINIMAX_API_KEY=***REDACTED***
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# AGENTORG_LLM_TIMEOUT=60

# ─── MiniMax 图像生成 (sandbox/hailuo_video/image_engine.py, V2.2) ─────
# 端点：{MINIMAX_BASE_URL}/image_generation（D-013 用户核实；非 OpenAI DALL-E 风格 /images/generations）
# 模型 image-01；响应 `base64`（推荐，无过期）/ `url`（24h 过期）
# MINIMAX_IMAGE_MODEL=image-01
# MINIMAX_IMAGE_RESPONSE_FORMAT=base64        # base64 | url
# MINIMAX_IMAGE_ASPECT_RATIO=16:9             # 1:1 | 16:9 | 4:3 | 3:4 | 9:16 等
# MINIMAX_IMAGE_N=1                            # 1-9

# ─── Google Gemini "Nano Banana" 图像生成 (sandbox/hailuo_video/image_engine.py) ────
# 端点：{GEMINI_BASE_URL}/models/gemini-2.5-flash-image:generateContent
# 认证：header `x-goog-api-key`。与 MiniMax 的两条硬差异：
#   · 无 url 响应模式 —— 永远返回 inline base64
#   · 无 n 参数 —— n>1 走顺序多次调用（逐张计费，约 $0.039/张）
# i2i 参考图走本地文件或 URL（inlineData），需要先跑 prep 缓存资产。
# aspectRatio 只认下面这 10 个值，且必须放 generationConfig（写进 prompt 无效）。
# GEMINI_API_KEY=***REDACTED***
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_ASPECT_RATIO=16:9                 # 1:1 2:3 3:2 3:4 4:3 4:5 5:4 9:16 16:9 21:9
# GEMINI_IMAGE_N=1                               # 1-9（顺序调用，逐张计费）

# ─── VLM 画面评审 (V3.8 W6, sandbox/hailuo_video/vlm_review.py) ──────────────────
# 可选。只有跑 `review --backend gemini --enable-real` 时才需要；默认走 mock（零调用）。
# 与出图模型分开：评审需要**多模态**模型（能读图并输出评分 JSON）。
# GEMINI_VLM_MODEL=gemini-2.5-flash

# ─── 本地视频推理 (sandbox/hailuo_video/, V2-Local, diffusers / CogVideoX) ──────
# 全部可选；默认值即可跑。CPU 推理慢（R1：5s 视频 30min+），GPU 设 cuda + bf16。
# LOCAL_VIDEO_MODEL=THUDM/CogVideoX-2b          # HuggingFace repo id
# LOCAL_VIDEO_DEVICE=cpu                          # cpu | cuda
# LOCAL_VIDEO_DTYPE=float32                       # float32 | float16 | bfloat16
# LOCAL_VIDEO_NUM_FRAMES=49                       # ~6s @ 8fps
# LOCAL_VIDEO_HEIGHT=480
# LOCAL_VIDEO_WIDTH=720
# LOCAL_VIDEO_STEPS=50                            # smoke 测试降到 5
# LOCAL_VIDEO_GUIDANCE=6.0
# LOCAL_VIDEO_SEED=-1                             # -1 = 随机
# LOCAL_VIDEO_CACHE_DIR=                           # 留空走 ~/.cache/huggingface

# ─── MiniMax 真 AI 视频生成 (sandbox/hailuo_video/motion_backend.py, V3.1.1) ─
# 端点：用户购买 platform.minimaxi.com（国内站 Token Plan），默认 endpoint = 国内站。
# 海外站 api.minimax.io 已被实测 401 invalid_api_key。
# 跑通前必须用 curl 验证 UNVERIFIED schema：
#   curl --request POST --url <endpoint> --header "Authorization: Bearer $KEY" --data '{...}'
# MINIMAX_VIDEO_ENDPOINT=https://api.minimaxi.com/v1/video_generation
# MINIMAX_VIDEO_QUERY_ENDPOINT=https://api.minimaxi.com/v1/query/video_generation
# MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# MINIMAX_VIDEO_POLL_TIMEOUT=180     # 秒（提交到 Success 的硬上限）
# MINIMAX_VIDEO_POLL_INTERVAL=5      # 秒
# MINIMAX_VIDEO_RESOLUTION=1080P
# MINIMAX_VIDEO_DURATION=6          # 秒